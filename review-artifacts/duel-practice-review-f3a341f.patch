+        private void StartPresetPreparation(string presetName, List<EquipSetEntry> entries)
+        {
+            List<PendingEquipAction> desiredActions = new List<PendingEquipAction>();
+            PresetPolicy policy = _config.GetOrCreatePolicy(presetName);
+
+            foreach (EquipSetEntry entry in entries)
+            {
+                if (!TryParseSlot(entry.Slot, out EquipSlot slot))
+                {
+                    Chat.WriteLine($"Skipping invalid slot '{entry.Slot}' in preset '{presetName}'.");
+                    continue;
+                }
+
+                desiredActions.Add(new PendingEquipAction(entry.ItemName, slot, presetName: presetName, policySnapshot: policy.Clone()));
+            }
+
+            if (desiredActions.Count == 0)
+            {
+                Chat.WriteLine($"Preset '{presetName}' has no valid entries.");
+                return;
+            }
+
+            _pendingPresetPreparationState = new PendingPresetPreparationState(
+                presetName,
+                desiredActions,
+                DateTime.UtcNow);
+
+            if (TryOpenClosedInventoryBags(out int openedBagCount))
+            {
+                Chat.WriteLine($"Preparing preset '{presetName}'. Opening {openedBagCount} inventory bag(s) first.");
+                return;
+            }
+
+            FinalizePresetPreparation();
+        }
+
+        private void DryRunPreset(string presetName, List<EquipSetEntry> entries)
+        {
+            PresetDryRunReport report = BuildPresetDryRunReport(presetName, entries);
+            _lastMissingItems.Clear();
+            _lastMissingItems.AddRange(report.MissingItems);
+
+            Chat.WriteLine($"Dry run '{presetName}': {report.ReadyActions.Count} ready, {report.AlreadyEquipped.Count} already equipped, {report.LockedActions.Count} locked, {report.MissingItems.Count} missing, {report.Blockers.Count} blockers.");
+
+            foreach (string detail in report.ReadyDetails)
+            {
+                Chat.WriteLine($"Ready: {detail}");
+            }
+
+            foreach (string detail in report.AlreadyEquipped)
+            {
+                Chat.WriteLine($"Already equipped: {detail}");
+            }
+
+            foreach (string detail in report.LockedActions)
+            {
+                Chat.WriteLine($"Locked: {detail}");
+            }
+
+            foreach (string detail in report.MissingItems)
+            {
+                Chat.WriteLine($"Missing: {detail}");
+            }
+
+            foreach (string detail in report.Blockers)
+            {
+                Chat.WriteLine($"Blocked: {detail}");
+            }
+
+            RecordSwapResult(new SwapResultEntry
+            {
+                AtUtc = DateTime.UtcNow,
+                PresetName = presetName,
+                Status = report.Blockers.Count > 0 ? "blocked" : (report.MissingItems.Count > 0 ? "missing" : "ready"),
+                Message = $"Dry run: {report.ReadyActions.Count} ready, {report.MissingItems.Count} missing, {report.Blockers.Count} blockers."
+            });
+        }
+
+        private PresetDryRunReport BuildPresetDryRunReport(string presetName, List<EquipSetEntry> entries)
+        {
+            PresetPolicy policy = _config.GetOrCreatePolicy(presetName);
+            var report = new PresetDryRunReport();
+
+            foreach (EquipSetEntry entry in entries.OrderBy(x => x.Slot, StringComparer.OrdinalIgnoreCase))
+            {
+                if (!TryParseSlot(entry.Slot, out EquipSlot slot))
+                {
+                    report.Blockers.Add($"Invalid slot '{entry.Slot}' for '{entry.ItemName}'.");
+                    continue;
+                }
+
+                if (IsSlotLocked(slot))
+                {
+                    report.LockedActions.Add($"{slot}: {entry.ItemName}");
+                    continue;
+                }
+
+                if (TryFindEquippedItemInSlot(slot, out Item equippedItem) &&
+                    IsMatchingItemName(equippedItem?.Name, entry.ItemName))
+                {
+                    string detail = $"{slot}: {entry.ItemName}";
+                    if (policy.ContinueIfEquipped)
+                    {
+                        report.AlreadyEquipped.Add(detail);
+                    }
+                    else
+                    {
+                        report.Blockers.Add($"{detail} already equipped and policy is stop.");
+                    }
+                    continue;
+                }
+
+                PendingEquipAction action = new PendingEquipAction(entry.ItemName, slot, presetName: presetName, policySnapshot: policy.Clone());
+                if (!TryFindAccessibleItem(action, out Item item, out string sourceDescription, out BagReference sourceBagReference))
+                {
+                    string detail = $"{slot}: {entry.ItemName}";
+                    if (policy.MissingItemMode == MissingItemMode.Stop)
+                    {
+                        report.Blockers.Add($"{detail} missing and policy is stop.");
+                    }
+                    else
+                    {
+                        report.MissingItems.Add(detail);
+                    }
+                    continue;
+                }
+
+                PendingEquipAction resolvedAction = action.WithResolvedSource(GetItemIdentityKey(item), sourceBagReference);
+                report.ReadyActions.Add(resolvedAction);
+                report.ReadyDetails.Add($"{slot}: {item.Name} from {DescribeSource(sourceDescription)}");
+            }
+
+            return report;
+        }
+
+        private void FinalizePresetPreparation()
+        {
+            if (_pendingPresetPreparationState == null)
+            {
+                return;
+            }
+
+            string presetName = _pendingPresetPreparationState.PresetName;
+            List<EquipSetEntry> entries = _pendingPresetPreparationState.DesiredActions
+                .Select(action => new EquipSetEntry
+                {
+                    Slot = action.TargetSlot?.ToString(),
+                    ItemName = action.ItemName
+                })
+                .ToList();
+            PresetDryRunReport report = BuildPresetDryRunReport(presetName, entries);
+
+            _pendingPresetPreparationState = null;
+            _lastMissingItems.Clear();
+            _lastMissingItems.AddRange(report.MissingItems);
+
+            if (report.Blockers.Count > 0)
+            {
+                Chat.WriteLine($"Preset '{presetName}' blocked: {report.Blockers.Count} issue(s).");
+                foreach (string blocker in report.Blockers)
+                {
+                    Chat.WriteLine($"Blocked: {blocker}");
+                }
+                RecordSwapResult(new SwapResultEntry
+                {
+                    AtUtc = DateTime.UtcNow,
+                    PresetName = presetName,
+                    Status = "blocked",
+                    Message = string.Join(" | ", report.Blockers.Take(3))
+                });
+                return;
+            }
+
+            foreach (PendingEquipAction action in OrderPreparedActions(report.ReadyActions))
+            {
+                _equipQueue.Enqueue(action);
+            }
+
+            Chat.WriteLine($"Preset '{presetName}' preflight: {report.ReadyActions.Count} ready, {report.AlreadyEquipped.Count} already equipped, {report.MissingItems.Count} missing, {report.LockedActions.Count} locked.");
+
+            foreach (string missingItem in report.MissingItems.Distinct(StringComparer.OrdinalIgnoreCase))
+            {
+                Chat.WriteLine($"Missing for preset '{presetName}': {missingItem}");
+            }
+
+            foreach (string lockedItem in report.LockedActions)
+            {
+                Chat.WriteLine($"Locked for preset '{presetName}': {lockedItem}");
+            }
+
+            if (report.MissingItems.Count > 0)
+            {
+                RecordSwapResult(new SwapResultEntry
+                {
+                    AtUtc = DateTime.UtcNow,
+                    PresetName = presetName,
+                    Status = "missing",
+                    Message = $"{report.ReadyActions.Count} ready, {report.MissingItems.Count} missing."
+                });
+            }
+        }
+
+        private IEnumerable<PendingEquipAction> OrderPreparedActions(IEnumerable<PendingEquipAction> actions)
+        {
+            return actions
+                .OrderByDescending(action =>
+                    action.TargetSlot.HasValue &&
+                    TryFindEquippedItemInSlot(action.TargetSlot.Value, out Item equippedItem) &&
+                    !IsMatchingItemName(equippedItem?.Name, action.ItemName))
+                .ThenBy(action => action.TargetSlot?.ToString(), StringComparer.OrdinalIgnoreCase);
+        }
+
+        private void SaveSetEntry(string[] parameters)
+        {
+            if (parameters.Length < 4)
+            {
+                Chat.WriteLine("Usage: /equip save <setName> <slot> <item name>");
+                return;
+            }
+
+            string setName = NormalizePresetName(parameters[1]);
+            string slotToken = parameters[2];
+
+            if (!TryParseSlot(slotToken, out EquipSlot slot))
+            {
+                Chat.WriteLine($"Unknown slot '{slotToken}'. Use /equip slots to see valid names.");
+                return;
+            }
+
+            string itemName = JoinArguments(parameters, 3);
+
+            if (string.IsNullOrWhiteSpace(itemName))
+            {
+                Chat.WriteLine("Usage: /equip save <setName> <slot> <item name>");
+                return;
+            }
+
+            _config.Upsert(setName, slot.ToString(), itemName);
+            SaveConfig();
+            EnsurePresetCommandRegistered(setName);
+            _activePresetName = setName;
+
+            Chat.WriteLine($"Saved '{itemName}' to preset '{setName}' for slot '{slot}'.");
+        }
