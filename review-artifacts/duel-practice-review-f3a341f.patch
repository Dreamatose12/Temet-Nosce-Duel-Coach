+        private void HandleEquipCommand(string command, string[] parameters, ChatWindow chatWindow)
+        {
+            if (parameters == null || parameters.Length == 0)
+            {
+                WriteHelp();
+                return;
+            }
+
+            string action = parameters[0].ToLowerInvariant();
+
+            switch (action)
+            {
+                case "help":
+                    WriteHelp();
+                    return;
+                case "overflow":
+                    HandleOverflowCommand(parameters);
+                    return;
+                case "ui":
+                    ShowWindow();
+                    return;
+                case "presets":
+                    ListPresets();
+                    return;
+                case "savecurrent":
+                    SaveCurrentlyEquipped(parameters);
+                    return;
+                case "dryrun":
+                    HandleDryRunCommand(parameters);
+                    return;
+                case "policy":
+                    HandlePolicyCommand(parameters);
+                    return;
+                case "lock":
+                    HandleLockCommand(parameters);
+                    return;
+                case "unlock":
+                    HandleUnlockCommand(parameters);
+                    return;
+                case "locks":
+                    HandleListLocksCommand();
+                    return;
+                case "capture":
+                    CaptureEquippedSlot(parameters);
+                    return;
+                case "scanindex":
+                    HandleScanIndexCommand();
+                    return;
+                case "find":
+                    HandleFindCommand(parameters);
+                    return;
+                case "preset":
+                    HandlePresetCommand(parameters);
+                    return;
+                case "slots":
+                    WriteSlots();
+                    return;
+                case "list":
+                    ListSets();
+                    return;
+                case "show":
+                    ShowSet(parameters);
+                    return;
+                case "set":
+                    EquipSet(parameters);
+                    return;
+                case "save":
+                    SaveSetEntry(parameters);
+                    return;
+                case "remove":
+                    RemoveSetEntry(parameters);
+                    return;
+                case "delete":
+                    DeleteSet(parameters);
+                    return;
+                case "clear":
+                    ResetSwapPipeline();
+                    Chat.WriteLine("Equip queue cleared.");
+                    return;
+                default:
+                    if (TryResolvePresetName(action, out string presetName))
+                    {
+                        QueueSetByName(presetName);
+                        return;
+                    }
+
+                    QueueSingleEquip(parameters);
+                    return;
+            }
+        }
