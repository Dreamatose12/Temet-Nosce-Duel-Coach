+        private static bool TryFindInventoryOnlyItem(PendingEquipAction action, out Item item)
+        {
+            item = FindMatchingItem(Inventory.Items.Where(candidate =>
+                candidate != null &&
+                !candidate.IsEquipped &&
+                GetIdentityProperty<Identity>(candidate, "Slot").Type == IdentityType.Inventory), action);
+
+            return item != null;
+        }
