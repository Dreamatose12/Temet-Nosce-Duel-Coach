+        private static bool TryFindOpenBankItem(string itemName, out Item item, out Backpack backpack)
+        {
+            backpack = null;
+            var bank = new Bank();
+
+            item = bank.Items.FirstOrDefault(candidate =>
+                !string.IsNullOrWhiteSpace(candidate.Name) &&
+                candidate.Name.IndexOf(itemName, StringComparison.OrdinalIgnoreCase) >= 0);
+
+            if (item != null)
+            {
+                return true;
+            }
+
+            foreach (Backpack pack in bank.Backpacks)
+            {
+                Item foundItem = pack.Items.FirstOrDefault(candidate =>
+                    !string.IsNullOrWhiteSpace(candidate.Name) &&
+                    candidate.Name.IndexOf(itemName, StringComparison.OrdinalIgnoreCase) >= 0);
+
+                if (foundItem == null)
+                {
+                    continue;
+                }
+
+                item = foundItem;
+                backpack = pack;
+                return true;
+            }
+
+            return false;
+        }
+
+        private static bool TryFindOpenBankItemByContainerName(string itemName, string containerName, out Item item, out Backpack backpack)
+        {
+            item = null;
+            backpack = null;
+
+            if (string.IsNullOrWhiteSpace(containerName))
+            {
+                return false;
+            }
+
+            var bank = new Bank();
+            foreach (Backpack pack in bank.Backpacks)
+            {
+                if (string.IsNullOrWhiteSpace(pack.Name) ||
+                    pack.Name.IndexOf(containerName, StringComparison.OrdinalIgnoreCase) < 0)
+                {
+                    continue;
+                }
+
+                Item foundItem = pack.Items.FirstOrDefault(candidate =>
+                    !string.IsNullOrWhiteSpace(candidate.Name) &&
+                    candidate.Name.IndexOf(itemName, StringComparison.OrdinalIgnoreCase) >= 0);
+
+                if (foundItem == null)
+                {
+                    continue;
+                }
+
+                item = foundItem;
+                backpack = pack;
+                return true;
+            }
+
+            return false;
+        }
