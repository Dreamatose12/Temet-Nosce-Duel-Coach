+        private void RememberItemHomeBag(Item item, BagReference sourceBagReference)
+        {
+            string itemKey = GetItemIdentityKey(item);
+            if (string.IsNullOrWhiteSpace(itemKey) || sourceBagReference == null)
+            {
+                return;
