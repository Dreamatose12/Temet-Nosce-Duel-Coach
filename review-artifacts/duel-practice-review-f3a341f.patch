+
+        private static string EscapeSendKeysText(string value)
+        {
+            if (string.IsNullOrEmpty(value))
+            {
+                return string.Empty;
+            }
+
+            return value
+                .Replace("{", "{{}")
+                .Replace("}", "{}}")
+                .Replace("+", "{+}")
+                .Replace("^", "{^}")
+                .Replace("%", "{%}")
+                .Replace("~", "{~}")
+                .Replace("(", "{(}")
+                .Replace(")", "{)}")
+                .Replace("[", "{[}")
+                .Replace("]", "{]}");
+        }
