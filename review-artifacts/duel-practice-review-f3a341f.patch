+        private void LoadRememberedItemHomeBags()
+        {
+            _itemHomeBags.Clear();
+
+            foreach (KeyValuePair<string, BagReferenceConfig> entry in _config.RememberedItemHomeBags)
+            {
+                BagReference bagReference = entry.Value?.ToBagReference();
+                if (bagReference == null)
+                {
+                    continue;
+                }
+
+                _itemHomeBags[entry.Key] = bagReference;
+            }
+        }
