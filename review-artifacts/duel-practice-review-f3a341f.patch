+        private List<EquipSetEntry> GetActivePresetEntries()
+        {
+            if (string.IsNullOrWhiteSpace(_activePresetName) ||
+                !_config.TryGetSet(_activePresetName, out List<EquipSetEntry> entries))
+            {
+                return new List<EquipSetEntry>();
+            }
+
+            return entries
+                .OrderBy(x => x.Slot, StringComparer.OrdinalIgnoreCase)
+                .ToList();
+        }
+
+        private string GetActiveStepSummary()
+        {
+            if (_pendingPresetPreparationState != null)
+            {
+                return $"Preparing {_pendingPresetPreparationState.PresetName}";
+            }
+
+            if (_pendingBagOpenState != null)
+            {
+                return $"Opening bags for {_pendingBagOpenState.Action.ItemName}";
+            }
+
+            if (_pendingInventoryMoveState != null)
+            {
+                return $"Moving {_pendingInventoryMoveState.Action.ItemName} to inventory";
+            }
+
+            if (_pendingBankAccessState != null)
+            {
+                return $"Waiting for bank access for {_pendingBankAccessState.ItemName}";
+            }
+
+            if (_pendingSlotClearState != null)
+            {
+                return $"Clearing {_pendingSlotClearState.TargetSlot}";
+            }
+
+            if (_pendingEquipState != null)
+            {
+                return $"Equipping {_pendingEquipState.ItemName}";
+            }
+
+            return "Idle";
+        }
+
+        private string BuildPresetDiffText()
+        {
+            if (string.IsNullOrWhiteSpace(_activePresetName) ||
+                !_config.TryGetSet(_activePresetName, out List<EquipSetEntry> entries))
+            {
+                return "No preset selected.";
+            }
+
+            List<string> lines = new List<string>();
+            foreach (EquipSetEntry entry in entries.OrderBy(x => x.Slot, StringComparer.OrdinalIgnoreCase))
+            {
+                if (!TryParseSlot(entry.Slot, out EquipSlot slot))
+                {
+                    lines.Add($"{entry.Slot}: invalid");
+                    continue;
+                }
+
+                string equippedName = TryFindEquippedItemInSlot(slot, out Item equippedItem) ? equippedItem?.Name : "(empty)";
+                bool matches = IsMatchingItemName(equippedName, entry.ItemName);
+                lines.Add($"{slot}: {(matches ? "match" : "swap")} | {TrimForPanel(equippedName ?? "(empty)", 22)} -> {TrimForPanel(entry.ItemName, 22)}");
+            }
+
+            if (lines.Count > 6)
+            {
+                lines = lines.Take(6).Concat(new[] { $"... {lines.Count - 6} more" }).ToList();
+            }
+
+            return lines.Count == 0 ? "No preset entries to compare." : string.Join("\n", lines);
+        }
+
+        private static string TrimForPanel(string value, int maxLength)
+        {
+            if (string.IsNullOrWhiteSpace(value) || value.Length <= maxLength)
+            {
+                return value;
+            }
+
+            return value.Substring(0, Math.Max(0, maxLength - 3)) + "...";
+        }
