+        private static bool TryFindAccessibleItem(string itemName, out Item item, out string sourceDescription, out BagReference sourceBagReference)
+        {
+            if (TryFindItem(itemName, out item))
+            {
+                sourceDescription = null;
+                sourceBagReference = null;
+                return true;
+            }
+
+            foreach (Backpack backpack in Inventory.Backpacks)
+            {
+                item = FindMatchingItem(backpack.Items, itemName);
+                if (item != null)
+                {
+                    sourceDescription = string.IsNullOrWhiteSpace(backpack.Name) ? "an inventory bag" : backpack.Name;
+                    sourceBagReference = new BagReference(backpack.Identity, sourceDescription);
+                    return true;
+                }
+            }
+
+            sourceDescription = null;
+            sourceBagReference = null;
+            item = null;
+            return false;
+        }
+
+        private static bool TryFindAccessibleItem(PendingEquipAction action, out Item item, out string sourceDescription, out BagReference sourceBagReference)
+        {
+            if (TryFindInventoryOnlyItem(action, out item))
+            {
+                sourceDescription = null;
+                sourceBagReference = null;
+                return true;
+            }
+
+            if (action.InventoryOnly)
+            {
+                sourceDescription = null;
+                sourceBagReference = null;
+                item = null;
+                return false;
+            }
+
+            if (action.SourceBagReference != null &&
+                TryResolveBackpack(action.SourceBagReference, out Backpack preferredBackpack) &&
+                preferredBackpack.IsOpen)
+            {
+                item = FindMatchingItem(preferredBackpack.Items, action);
+                if (item != null)
+                {
+                    sourceDescription = string.IsNullOrWhiteSpace(preferredBackpack.Name) ? "an inventory bag" : preferredBackpack.Name;
+                    sourceBagReference = new BagReference(preferredBackpack.Identity, sourceDescription);
+                    return true;
+                }
+            }
+
+            foreach (Backpack backpack in Inventory.Backpacks.Where(candidate => candidate.IsOpen))
+            {
+                item = FindMatchingItem(backpack.Items, action);
+                if (item != null)
+                {
+                    sourceDescription = string.IsNullOrWhiteSpace(backpack.Name) ? "an inventory bag" : backpack.Name;
+                    sourceBagReference = new BagReference(backpack.Identity, sourceDescription);
+                    return true;
+                }
+            }
+
+            sourceDescription = null;
+            sourceBagReference = null;
+            item = null;
+            return false;
+        }
+
+        private static bool TryOpenClosedInventoryBags(out int openedBagCount)
+        {
+            openedBagCount = 0;
+
+            foreach (Backpack backpack in Inventory.Backpacks.Where(candidate => !candidate.IsOpen).ToList())
+            {
+                Item bagItem = Inventory.Items.FirstOrDefault(candidate =>
+                    candidate != null &&
+                    candidate.UniqueIdentity == backpack.Identity);
+
+                if (bagItem == null)
+                {
+                    continue;
+                }
+
+                try
+                {
+                    bagItem.Use();
+                    bagItem.Use();
+                    openedBagCount++;
+                }
+                catch
+                {
+                }
+            }
+
+            return openedBagCount > 0;
+        }
