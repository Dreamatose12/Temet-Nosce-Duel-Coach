+using System;
+using AOSharp.Core;
+using AOSharp.Core.UI;
+
+namespace ProfessionHandler.Agent.DuelPractice
+{
+    public class Main : AOPluginEntry
+    {
+        private AgentDuelPracticeHandler _handler;
+
+        public override void Teardown()
+        {
+            _handler?.StopPracticeService();
+            _handler = null;
+        }
+        public override void Run()
+        {
+            try
+            {
+                if (Game.IsNewEngine)
+                {
+                    Chat.WriteLine("Duel Practice does not support the new engine.");
+                    return;
+                }
+
+                _handler = new AgentDuelPracticeHandler(PluginDirectory);
+                global::ProfessionHandler.Generic.Combat.ProfessionHandler.Set(_handler);
+            }
+            catch (Exception e)
+            {
+                Chat.WriteLine(e.Message);
+            }
+        }
+    }
+}
diff --git a/Profession Handlers/ProfessionHandler.Agent.DuelPractice/PracticeService.cs b/Profession Handlers/ProfessionHandler.Agent.DuelPractice/PracticeService.cs
