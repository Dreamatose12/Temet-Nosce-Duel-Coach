+        private static bool TryLookupItemFinder(string itemName, out ItemFinderLookupResult result, out string message)
+        {
+            result = null;
+            message = null;
+
+            string toolkitPath = GetItemFinderPath();
+
+            string assemblyPath = Path.Combine(toolkitPath, "Malis Item Finder.dll");
+            if (!File.Exists(assemblyPath))
+            {
+                return false;
+            }
+
+            try
+            {
+                AppDomain.CurrentDomain.AssemblyResolve += ResolveItemFinderAssemblies;
+
+                Assembly assembly = Assembly.LoadFrom(assemblyPath);
+                Type databaseType = assembly.GetType("MalisItemFinder.Database");
+                object database = Activator.CreateInstance(databaseType);
+
+                Type filterCriteriaType = assembly.GetType("FilterCriteria");
+                Type searchCriteriaType = assembly.GetType("SearchCriteria");
+                Type slotType = assembly.GetType("EFDataAccessLibrary.Models.Slot");
+                Type itemInfoType = assembly.GetType("EFDataAccessLibrary.Models.ItemInfo");
+                Type itemContainerType = assembly.GetType("EFDataAccessLibrary.Models.ItemContainer");
+                Type containerIdType = assembly.GetType("ContainerId");
+
+                Type listSearchCriteriaType = typeof(List<>).MakeGenericType(searchCriteriaType);
+                Type dictionaryType = typeof(Dictionary<,>).MakeGenericType(filterCriteriaType, listSearchCriteriaType);
+                object criteria = Activator.CreateInstance(dictionaryType);
+
+                object searchTerms = new[] { itemName };
+                object[] args = { DynelManager.LocalPlayer.Name, searchTerms, criteria, 10, 0 };
+
+                MethodInfo itemLookup = databaseType.GetMethod("ItemLookup");
+                var results = itemLookup.Invoke(database, args) as System.Collections.IEnumerable;
+                object firstSlot = results?.Cast<object>().FirstOrDefault();
+                if (firstSlot == null)
+                {
+                    return false;
+                }
+
+                object itemInfo = slotType.GetProperty("ItemInfo").GetValue(firstSlot);
+                object itemContainer = slotType.GetProperty("ItemContainer").GetValue(firstSlot);
+                string foundName = itemInfoType.GetProperty("Name").GetValue(itemInfo) as string;
+                object containerInstance = itemContainerType.GetProperty("ContainerInstance").GetValue(itemContainer);
+                object rootContainer = itemContainerType.GetProperty("Root").GetValue(itemContainer);
+
+                string containerName = Enum.GetName(containerIdType, containerInstance) ?? containerInstance.ToString();
+                string rootName = Enum.GetName(containerIdType, rootContainer) ?? rootContainer.ToString();
+                string containerDisplayName = TryReadStringMember(itemContainer, "Name", "DisplayName", "ContainerName", "Label");
+                string rootDisplayName = TryReadStringMember(rootContainer, "Name", "DisplayName", "ContainerName", "Label");
+
+                result = new ItemFinderLookupResult
+                {
+                    FoundName = foundName,
+                    ContainerName = containerName,
+                    RootName = rootName,
+                    ContainerDisplayName = string.IsNullOrWhiteSpace(containerDisplayName) ? containerName : containerDisplayName,
+                    RootDisplayName = string.IsNullOrWhiteSpace(rootDisplayName) ? rootName : rootDisplayName,
+                    IsBank = string.Equals(containerName, "Bank", StringComparison.OrdinalIgnoreCase) ||
+                             string.Equals(rootName, "Bank", StringComparison.OrdinalIgnoreCase)
+                };
+
+                if (result.IsBank)
+                {
+                    string bagHint = string.IsNullOrWhiteSpace(result.ContainerDisplayName) || string.Equals(result.ContainerDisplayName, "Bank", StringComparison.OrdinalIgnoreCase)
+                        ? "the bank"
+                        : result.ContainerDisplayName;
+                    message = $"ItemFinder found '{foundName}' in bank container '{bagHint}'. Open that bank bag, then run /equip find again.";
+                    return true;
+                }
+
+                message = $"ItemFinder found '{foundName}' in {result.ContainerDisplayName} (root: {result.RootDisplayName}).";
+                return true;
+            }
+            catch (Exception ex)
+            {
+                Exception actualException = ex is TargetInvocationException invocationException && invocationException.InnerException != null
+                    ? invocationException.InnerException
+                    : ex;
+
+                message = $"ItemFinder lookup failed: {actualException.Message}";
+                return true;
+            }
+            finally
+            {
+                AppDomain.CurrentDomain.AssemblyResolve -= ResolveItemFinderAssemblies;
+            }
+        }
+
+        private static string TryReadStringMember(object instance, params string[] memberNames)
+        {
+            if (instance == null)
+            {
+                return null;
+            }
+
+            Type type = instance.GetType();
+            foreach (string memberName in memberNames)
+            {
+                object propertyValue = type.GetProperty(memberName, BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance)
+                    ?.GetValue(instance);
+                if (propertyValue is string propertyString && !string.IsNullOrWhiteSpace(propertyString))
+                {
+                    return propertyString;
+                }
+
+                object fieldValue = type.GetField(memberName, BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance)
+                    ?.GetValue(instance);
+                if (fieldValue is string fieldString && !string.IsNullOrWhiteSpace(fieldString))
+                {
+                    return fieldString;
+                }
+            }
+
+            return null;
+        }
+
+        private static bool TryStartItemFinderScan(out string message)
+        {
+            message = null;
+
+            string toolkitPath = GetItemFinderPath();
+            string assemblyPath = Path.Combine(toolkitPath, "Malis Item Finder.dll");
+
+            if (!File.Exists(assemblyPath))
+            {
+                message = "Could not find Mali's Item Finder installation.";
+                return false;
+            }
+
+            try
+            {
+                AppDomain.CurrentDomain.AssemblyResolve += ResolveItemFinderAssemblies;
+
+                Assembly assembly = Assembly.LoadFrom(assemblyPath);
+                Type mainType = assembly.GetType("MalisItemFinder.Main");
+                Type settingsType = assembly.GetType("MalisItemFinder.Settings");
+                Type databaseType = assembly.GetType("MalisItemFinder.Database");
+                Type itemScannerType = assembly.GetType("MalisItemFinder.ItemScanner");
+
+                string settingsPath = Path.Combine(toolkitPath, "JSON", "Settings.json");
+                object settings = Activator.CreateInstance(settingsType, settingsPath);
+                object database = Activator.CreateInstance(databaseType);
+                object scanner = Activator.CreateInstance(itemScannerType);
+
+                databaseType
+                    .GetMethod("LoadDb", BindingFlags.NonPublic | BindingFlags.Instance)
+                    ?.Invoke(database, Array.Empty<object>());
+
+                SetStaticField(mainType, "PluginDir", toolkitPath);
+                SetStaticField(mainType, "Settings", settings);
+                SetStaticField(mainType, "Database", database);
+                SetStaticField(mainType, "ItemScanner", scanner);
+
+                itemScannerType
+                    .GetMethod("Scan", BindingFlags.NonPublic | BindingFlags.Instance)
+                    ?.Invoke(scanner, Array.Empty<object>());
+
+                message = "Started Mali ItemFinder scan attempt. If the scanner path is compatible, it should begin indexing inventory and bank bags.";
+                return true;
+            }
+            catch (Exception ex)
+            {
+                message = $"Failed to start Mali ItemFinder scan: {ex.Message}";
+                return false;
+            }
+            finally
+            {
+                AppDomain.CurrentDomain.AssemblyResolve -= ResolveItemFinderAssemblies;
+            }
+        }
+
+        private static Assembly ResolveItemFinderAssemblies(object sender, ResolveEventArgs args)
+        {
+            string toolkitPath = GetItemFinderPath();
+
+            string assemblyName = new AssemblyName(args.Name).Name + ".dll";
+            string candidatePath = Path.Combine(toolkitPath, assemblyName);
+
+            return File.Exists(candidatePath) ? Assembly.LoadFrom(candidatePath) : null;
+        }
+
+        private static string GetItemFinderPath()
+        {
+            return Path.Combine(
+                Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory),
+                "Mali's AO Toolkit",
+                "Mali's AO Toolkit",
+                "Malis-AO-Toolkit-27-01-26",
+                "Mali's AO Toolkit",
+                "lib",
+                "ItemFinder");
+        }
+
+        private static void SetStaticField(Type type, string fieldName, object value)
+        {
+            type.GetField(fieldName, BindingFlags.NonPublic | BindingFlags.Static)
+                ?.SetValue(null, value);
+        }
+
+        private static T GetIdentityProperty<T>(object instance, string propertyName)
+        {
+            if (instance == null)
+            {
+                return default;
+            }
+
+            Type type = instance.GetType();
+
+            object value = type
+                .GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance)
+                ?.GetValue(instance);
+
+            if (value == null)
+            {
+                value = type
+                    .GetField(propertyName, BindingFlags.Public | BindingFlags.Instance)
+                    ?.GetValue(instance);
+            }
+
+            return value is T typedValue ? typedValue : default;
+        }
