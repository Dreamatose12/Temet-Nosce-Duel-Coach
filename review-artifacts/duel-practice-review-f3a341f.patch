diff --git a/Profession Handlers/ProfessionHandler.Adv.DuelPractice/AdventurerDuelPracticeHandler.cs b/Profession Handlers/ProfessionHandler.Adv.DuelPractice/AdventurerDuelPracticeHandler.cs
