+        private bool TryStartInventoryFallback(PendingEquipAction action, out string message)
+        {
+            message = null;
+
+            if (action == null || action.InventoryOnly || action.AttemptCount + 1 >= MaxEquipAttempts)
+            {
+                return false;
+            }
+
+            if (TryFindInventoryOnlyItem(action, out _))
+            {
+                PendingEquipAction retryAction = action.WithInventoryOnly(true).WithAttemptCount(action.AttemptCount + 1);
+                _equipQueue.Enqueue(retryAction);
+                message = $"Retrying '{action.ItemName}' from inventory.";
+                return true;
+            }
+
+            if (!TryFindAccessibleItem(action, out Item item, out _, out BagReference sourceBagReference))
+            {
+                return false;
+            }
+
+            if (sourceBagReference == null)
+            {
+                return false;
+            }
+
+            if (Inventory.NumFreeSlots <= 0)
+            {
+                message = $"Cannot retry '{action.ItemName}' from inventory because inventory is full.";
+                return true;
+            }
+
+            try
+            {
+                item.MoveToInventory();
+                _pendingInventoryMoveState = new PendingInventoryMoveState(
+                    action.WithResolvedSource(GetItemIdentityKey(item), sourceBagReference)
+                        .WithInventoryOnly(true)
+                        .WithAttemptCount(action.AttemptCount + 1),
+                    DateTime.UtcNow);
+                message = $"Retrying '{action.ItemName}' from inventory.";
+                return true;
+            }
+            catch
+            {
+                return false;
+            }
+        }
