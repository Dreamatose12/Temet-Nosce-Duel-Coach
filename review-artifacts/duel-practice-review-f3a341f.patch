+        private void HandleFindCommand(string[] parameters)
+        {
+            string itemName = JoinArguments(parameters, 1);
+            if (string.IsNullOrWhiteSpace(itemName))
+            {
+                Chat.WriteLine("Usage: /equip find <item name>");
+                return;
+            }
+
+            if (TryFindItem(itemName, out Item inventoryItem))
+            {
+                Chat.WriteLine($"'{inventoryItem.Name}' is already available in inventory.");
+                return;
+            }
+
+            if (TryOpenClosedInventoryBags(out int openedBagCount))
+            {
+                Chat.WriteLine($"Opened {openedBagCount} inventory bag(s). Try /equip find {itemName} again in a moment.");
+                return;
+            }
+
+            InventoryBagLookupResult bagResult = TryResolveInventoryBagItem(itemName, out string sourceBag, out string foundItemName);
+            if (bagResult == InventoryBagLookupResult.MovedToInventory)
+            {
+                Chat.WriteLine($"Moved '{foundItemName}' from {sourceBag} into inventory.");
+                return;
+            }
+
+            if (bagResult == InventoryBagLookupResult.FoundButInventoryFull)
+            {
+                Chat.WriteLine($"Found '{foundItemName}' in {sourceBag}, but inventory is full.");
+                return;
+            }
+
+            if (bagResult == InventoryBagLookupResult.MoveFailed)
+            {
+                Chat.WriteLine($"Found '{foundItemName}' in {sourceBag}, but failed to move it to inventory.");
+                return;
+            }
+
+            if (TryFindOpenBankItem(itemName, out Item bankItem, out Backpack backpack))
+            {
+                string backpackName = backpack?.Name ?? "an open bank backpack";
+                Chat.WriteLine($"Found '{bankItem.Name}' in {backpackName}. Moving it to inventory.");
+                TryMoveBankItemToInventory(bankItem);
+                return;
+            }
+
+            if (TryLookupItemFinder(itemName, out ItemFinderLookupResult lookupResult, out string locationMessage))
+            {
+                if (lookupResult != null &&
+                    lookupResult.IsBank &&
+                    TryFindOpenBankItemByContainerName(itemName, lookupResult.ContainerDisplayName, out Item indexedBankItem, out Backpack indexedBackpack))
+                {
+                    string indexedBackpackName = indexedBackpack?.Name ?? lookupResult.ContainerDisplayName ?? "an open bank backpack";
+                    Chat.WriteLine($"ItemFinder matched '{lookupResult.FoundName}' to {indexedBackpackName}. Moving it to inventory.");
+                    TryMoveBankItemToInventory(indexedBankItem);
+                    return;
+                }
+
+                if (lookupResult != null &&
+                    lookupResult.IsBank &&
+                    TryUseMobileBankItem(out string mobileBankItemName))
+                {
+                    _pendingBankAccessState = new PendingBankAccessState(itemName, DateTime.UtcNow);
+                    Chat.WriteLine($"ItemFinder found '{lookupResult.FoundName}' in bank. Used '{mobileBankItemName}' to open bank access. Retrying automatically.");
+                    return;
+                }
+
+                Chat.WriteLine(locationMessage);
+                return;
+            }
+
+            Chat.WriteLine($"Could not find '{itemName}' in inventory, open bank bags, or ItemFinder.");
+        }
