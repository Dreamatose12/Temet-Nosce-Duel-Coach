+using System;
+using System.Collections.Generic;
+using System.Linq;
+using AOSharp.Common.GameData;
+using AOSharp.Core;
+
+namespace ProfessionHandler.Agent.DuelPractice.Equipment
+{
+    internal partial class DuelEquipmentEngine
+    {
+        public bool Busy => _equipQueue.Count != 0 || _pendingEquipState != null
+            || _pendingBagOpenState != null || _pendingSlotClearState != null
+            || _pendingPresetPreparationState != null || _pendingInventoryMoveState != null
+            || _pendingBankAccessState != null;
+
+        public void Tick()
+        {
+            if (Game.IsZoning || !DynelManager.LocalPlayer.IsAlive) { ResetSwapPipeline(); return; }
+            OnUpdate(this, 0);
+        }
+
+        public void Cancel() => ResetSwapPipeline();
+
+        public bool IsEquipped(string name)
+        {
+            return !string.IsNullOrWhiteSpace(name)
+                && _config.TryGetSet(NormalizePresetName(name), out var entries)
+                && entries.Count > 0 && entries.All(e => TryParseSlot(e.Slot, out var slot)
+                    && TryFindEquippedItemInSlot(slot, out var item)
+                    && IsMatchingItemName(item?.Name, e.ItemName));
+        }
+
+        // Require an explicit, currently equipped return preset covering all adaptive slots.
+        public bool CanRestore(string restore, IEnumerable<string> adaptive, out string reason)
+        {
+            reason = null;
+            if (!IsEquipped(restore)) { reason = "Return preset must exist and be equipped before practice"; return false; }
+            _config.TryGetSet(NormalizePresetName(restore), out var baseline);
+            var covered = new HashSet<EquipSlot>();
+            foreach (var entry in baseline)
+                if (TryParseSlot(entry.Slot, out var slot)) covered.Add(slot);
+            foreach (var name in adaptive.Where(n => !string.IsNullOrWhiteSpace(n)))
+            {
+                if (!_config.TryGetSet(NormalizePresetName(name), out var entries) || entries.Count == 0)
+                { reason = "Missing adaptive preset: " + name; return false; }
+                foreach (var entry in entries)
+                    if (!TryParseSlot(entry.Slot, out var slot) || !covered.Contains(slot))
+                    { reason = "Return preset does not cover adaptive slot: " + entry.Slot; return false; }
+            }
+            return true;
+        }
+
+        public bool TryQueue(string name, out string reason)
+        {
+            reason = null;
+            if (Busy) { reason = "Equipment pipeline busy"; return false; }
+            if (string.IsNullOrWhiteSpace(name) || !_config.TryGetSet(NormalizePresetName(name), out var entries) || entries.Count == 0)
+            { reason = "Preset not configured: " + name; return false; }
+            if (IsEquipped(name)) return true;
+            var report = BuildPresetDryRunReport(NormalizePresetName(name), entries);
+            if (report.Blockers.Count > 0 || report.MissingItems.Count > 0 || report.LockedActions.Count > 0)
+            { reason = "Preset blocked, missing items, or locked slots; inspect /equip dryrun " + name; return false; }
+            QueueSetByName(name);
+            return Busy || IsEquipped(name);
+        }
+    }
+}
