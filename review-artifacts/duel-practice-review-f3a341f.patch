+        private static bool TrySendMacroCommand(string macroCommand, out string error)
+        {
+            try
+            {
+                System.Windows.Forms.SendKeys.SendWait("{ENTER}");
+                Thread.Sleep(40);
+                System.Windows.Forms.SendKeys.SendWait(EscapeSendKeysText(macroCommand));
+                Thread.Sleep(40);
+                System.Windows.Forms.SendKeys.SendWait("{ENTER}");
+                error = null;
+                return true;
+            }
+            catch (Exception ex)
+            {
+                error = ex.Message;
+                return false;
+            }
