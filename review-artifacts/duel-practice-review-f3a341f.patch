@@ -0,0 +1,64 @@
+using System;
+using AOSharp.Common.GameData;
+using AOSharp.Core;
+
+namespace ProfessionHandler.Agent.DuelPractice
+{
+    internal enum DuelDecisionAction
+    {
+        HoldPerk,
+        UsePerk,
+        UseSpecial,
+        UseItem,
+        CastSpell,
+        SwapEquipment
+    }
+
+    // Decisions are observations/plans only. The generic combat hooks remain the executor.
+    internal sealed class DuelDecision
+    {
+        public DuelDecisionAction Action { get; }
+        public Identity Target { get; }
+        public string Reason { get; }
+        public string Confidence { get; }
+        public double CreatedAt { get; }
+
+        public DuelDecision(DuelDecisionAction action, Identity target, string reason,
+            string confidence, double createdAt)
+        {
+            Action = action;
+            Target = target;
+            Reason = reason;
+            Confidence = confidence;
+            CreatedAt = createdAt;
+        }
+    }
+
+    public partial class AgentDuelPracticeHandler
+    {
+        private DuelDecision MakeDecision(DuelDecisionAction action, SimpleChar target,
+            string reason, string confidence = "conditional")
+        {
+            return new DuelDecision(action, target?.Identity ?? Identity.None, reason,
+                confidence, Time.AONormalTime);
+        }
+
+        // Immediate execution gate: stale decisions and target changes are rejected.
+        private bool AuthorizeDecision(DuelDecision decision, SimpleChar currentTarget)
+        {
+            if (decision == null || currentTarget == null || !_sessionAccepted || _mode == PracticeMode.Punchbag)
+                return false;
+            if (decision.Target != currentTarget.Identity || decision.Target != _opponent)
+                return false;
+            if (Time.AONormalTime - decision.CreatedAt > 0.75)
+                return false;
+            return CanProcessPlayerTarget(currentTarget);
+        }
+
+        private void RecordDecision(DuelDecision decision)
+        {
+            if (decision == null) return;
+            RecordDecision($"{decision.Action}: {decision.Reason}; confidence={decision.Confidence}; target={decision.Target.Instance}");
+        }
+    }
+}
