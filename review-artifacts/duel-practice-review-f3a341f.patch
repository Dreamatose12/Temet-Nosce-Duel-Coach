+
+        private void SaveEquippedSlot(string presetName, string slotToken)
+        {
+            string normalizedPresetName = NormalizePresetName(presetName);
+
+            if (!TryParseSlot(slotToken, out EquipSlot slot))
+            {
+                Chat.WriteLine($"Unknown slot '{slotToken}'. Use /equip slots to see valid names.");
+                return;
+            }
+
+            if (!TryFindEquippedItemInSlot(slot, out Item equippedItem) || string.IsNullOrWhiteSpace(equippedItem?.Name))
+            {
+                Chat.WriteLine($"No equipped item found in slot '{slot}'.");
+                return;
+            }
+
+            Identity slotIdentity = GetIdentityProperty<Identity>(equippedItem, "Slot");
+            if (!TryMapSnapshotIdentityToEquipSlot(slotIdentity, out EquipSlot capturedSlot) || capturedSlot != slot)
+            {
+                Chat.WriteLine($"Slot '{slot}' is not part of swap preset capture. Use weapon, armor, HUD, util, wrist, finger, neck, and similar swap slots.");
+                return;
+            }
+
+            _config.Upsert(normalizedPresetName, slot.ToString(), equippedItem.Name);
+            SaveConfig();
+            EnsurePresetCommandRegistered(normalizedPresetName);
+            _activePresetName = normalizedPresetName;
+
+            Chat.WriteLine($"Captured '{equippedItem.Name}' from '{slot}' into preset '{normalizedPresetName}'.");
+        }
+
+        private void RemoveSetEntry(string[] parameters)
+        {
+            if (parameters.Length < 3)
+            {
+                Chat.WriteLine("Usage: /equip remove <setName> <slot>");
+                return;
+            }
+
+            string setName = NormalizePresetName(parameters[1]);
+            string slotToken = parameters[2];
+
+            if (!TryParseSlot(slotToken, out EquipSlot slot))
+            {
+                Chat.WriteLine($"Unknown slot '{slotToken}'. Use /equip slots to see valid names.");
+                return;
+            }
+
+            if (_config.Remove(setName, slot.ToString()))
+            {
+                SaveConfig();
+                Chat.WriteLine($"Removed slot '{slot}' from preset '{setName}'.");
+                return;
+            }
+
+            Chat.WriteLine($"No saved entry for slot '{slot}' in preset '{setName}'.");
+        }
