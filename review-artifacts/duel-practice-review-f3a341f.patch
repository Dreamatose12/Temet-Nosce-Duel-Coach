+        private void HandlePolicyCommand(string[] parameters)
+        {
+            if (parameters.Length < 2)
+            {
+                Chat.WriteLine("Usage: /equip policy show <presetName>");
+                Chat.WriteLine("Usage: /equip policy missing <presetName> <stop|skip>");
+                Chat.WriteLine("Usage: /equip policy equipped <presetName> <continue|stop>");
+                return;
+            }
+
+            string subCommand = parameters[1].ToLowerInvariant();
+            if (subCommand == "show")
+            {
+                string presetName = parameters.Length >= 3 ? NormalizePresetName(parameters[2]) : GetPresetInput();
+                if (string.IsNullOrWhiteSpace(presetName))
+                {
+                    Chat.WriteLine("Usage: /equip policy show <presetName>");
+                    return;
+                }
+
+                PresetPolicy policy = _config.GetOrCreatePolicy(presetName);
+                Chat.WriteLine($"Policy for '{presetName}': missing={policy.MissingItemMode}, equipped={(policy.ContinueIfEquipped ? "continue" : "stop")}.");
+                return;
+            }
+
+            if (parameters.Length < 4)
+            {
+                Chat.WriteLine("Usage: /equip policy missing <presetName> <stop|skip>");
+                Chat.WriteLine("Usage: /equip policy equipped <presetName> <continue|stop>");
+                return;
+            }
+
+            string targetPresetName = NormalizePresetName(parameters[2]);
+            PresetPolicy targetPolicy = _config.GetOrCreatePolicy(targetPresetName);
+            string value = parameters[3].ToLowerInvariant();
+
+            if (subCommand == "missing")
+            {
+                if (value != "stop" && value != "skip")
+                {
+                    Chat.WriteLine("Missing policy must be 'stop' or 'skip'.");
+                    return;
+                }
+
+                targetPolicy.MissingItemMode = value == "stop" ? MissingItemMode.Stop : MissingItemMode.Skip;
+                SaveConfig();
+                Chat.WriteLine($"Policy for '{targetPresetName}' updated: missing={targetPolicy.MissingItemMode}.");
+                RefreshSummary();
+                return;
+            }
+
+            if (subCommand == "equipped")
+            {
+                if (value != "continue" && value != "stop")
+                {
+                    Chat.WriteLine("Equipped policy must be 'continue' or 'stop'.");
+                    return;
+                }
+
+                targetPolicy.ContinueIfEquipped = value == "continue";
+                SaveConfig();
+                Chat.WriteLine($"Policy for '{targetPresetName}' updated: equipped={(targetPolicy.ContinueIfEquipped ? "continue" : "stop")}.");
+                RefreshSummary();
+                return;
+            }
+
+            Chat.WriteLine($"Unknown policy subcommand '{subCommand}'.");
+        }
