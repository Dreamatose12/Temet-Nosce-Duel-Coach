new file mode 100644
index 0000000..1bcb470
--- /dev/null
+++ b/Profession Handlers/ProfessionHandler.Agent.DuelPractice/DuelRecorder.cs	
@@ -0,0 +1,167 @@
+using System;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+using AOSharp.Common.GameData;
+using AOSharp.Core;
+using AOSharp.Core.Inventory;
+using Newtonsoft.Json;
+using SmokeLounge.AOtomation.Messaging.Messages;
+using SmokeLounge.AOtomation.Messaging.Messages.N3Messages;
+
+namespace ProfessionHandler.Agent.DuelPractice
+{
+    internal sealed class DuelRecorder
+    {
+        private readonly BlockingCollection<string> _lines = new BlockingCollection<string>(4096);
+        private readonly Task _writer;
+        private readonly Stopwatch _clock = Stopwatch.StartNew();
+        private readonly object _recordLock = new object();
+        private string _terminalLine;
+        private readonly Stat[] _stats = Enum.GetValues(typeof(Stat)).Cast<Stat>().Distinct().ToArray();
+        private int _statCursor;
+        private double _nextSample;
+        private int _dropped;
+        private bool _finished;
+        public volatile string Error;
+        public string SessionId { get; } = Guid.NewGuid().ToString("N");
+        public string FilePath { get; }
+
+        public DuelRecorder(string root, string mode, int botId, int opponentId, string opponentName)
+        {
+            string path = Path.Combine(root, SessionId + ".jsonl");
+            FilePath = path;
+            _writer = Task.Run(() =>
+            {
+                try
+                {
+                    Directory.CreateDirectory(root);
+                    using (var output = new StreamWriter(new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.Read)))
+                    {
+                        output.AutoFlush = true;
+                        foreach (var line in _lines.GetConsumingEnumerable()) output.WriteLine(line);
+                        // The terminal record cannot be lost to a full sample queue.
+                        if (_terminalLine != null) output.WriteLine(_terminalLine);
+                    }
+                }
+                catch (Exception e) { Error = e.GetType().Name + ": " + e.Message; }
+            });
+            Record("start", new { mode, botId, opponentId, opponentName, schema = 1,
+                visibility = "Client observations only. Raw target stats may be defaults or unavailable; they are not proof of server state or full equipment.",
+                integrations = new { discordServer = "Temet Nosce" } });
+        }
+
+        public void Record(string kind, object data)
+        {
+            lock (_recordLock)
+            {
+                if (_finished || Error != null) return;
+                if (!_lines.TryAdd(Serialize(kind, data))) _dropped++;
+            }
+        }
+
+        private string Serialize(string kind, object data)
+            => JsonConvert.SerializeObject(new { sessionId = SessionId, utc = DateTime.UtcNow,
+                elapsedSeconds = _clock.Elapsed.TotalSeconds, kind, data });
+
+        public void Sample(SimpleChar local, SimpleChar opponent, double now)
+        {
+            if (now < _nextSample || _finished) return;
+            _nextSample = now + 0.25;
+            Record("sample", new {
+                localHealth = local.Health, localHealthPercent = local.HealthPercent, localNanoPercent = local.NanoPercent,
+                targetHealth = opponent.Health, targetHealthPercent = opponent.HealthPercent,
+                distance = opponent.DistanceFrom(local),
+                targetBuffs = opponent.Buffs.Select(b => new { b.Name, b.RemainingTime,
+                    observation = "observed_client_wrapper" }).ToArray(),
+                localBuffs = local.Buffs.Select(b => new { b.Name, b.RemainingTime,
+                    observation = "observed_client_wrapper" }).ToArray()
+            });
+            // Incremental SDK reads, never cached native character wrappers.
+            for (int n = 0; n < 4 && _stats.Length > 0; n++)
+            {
+                var stat = _stats[_statCursor++ % _stats.Length];
+                try
+                {
+                    int value = opponent.GetStat(stat);
+                    Record("targetStat", new { stat = stat.ToString(), raw = value,
+                        quality = value == 1234567890 ? "sentinel" : "unverified_client_value" });
+                }
+                catch (Exception e) { Record("targetStat", new { stat = stat.ToString(), quality = "error", error = e.GetType().Name }); }
+            }
+        }
+
+        public void Finish(string reason)
+        {
+            lock (_recordLock)
+            {
+                if (_finished) return;
+                _terminalLine = Serialize("end", new { reason, droppedRecords = _dropped, writerError = Error });
+                _finished = true;
+                _lines.CompleteAdding();
+            }
+        }
+    }
+
+    public partial class AgentDuelPracticeHandler
+    {
+        private string _reportDirectory;
+        private DuelRecorder _recorder;
+        private string _lastDecision;
+        private double _nextDecisionRecord;
+
+        private void RecordDecision(string text)
+        {
+            if (text == _lastDecision && Time.AONormalTime < _nextDecisionRecord) return;
+            _lastDecision = text;
+            _nextDecisionRecord = Time.AONormalTime + 5;
+            _recorder?.Record("decision", new { reason = text });
+        }
+
+        // Port the TestPlugin network diagnostics as scoped observations, without its
+        // unconditional duel acceptance or developer commands that mutate the client.
+        private void RecordDuelPacket(object sender, N3Message message)
+        {
+            if (!OwnsPracticeService || !_sessionAccepted || _recorder == null) return;
+            if (message is HealthDamageMessage damage
+                && ((damage.Identity == _opponent && damage.Target == DynelManager.LocalPlayer.Identity)
+                    || (damage.Target == _opponent && damage.Identity == DynelManager.LocalPlayer.Identity)))
+            {
+                _recorder.Record("damagePacket", new { actor = damage.Identity.Instance,
+                    target = damage.Target.Instance, damage.Amount, damage.TargetHp, stat = damage.Stat.ToString(),
+                    quality = "scoped_client_packet_unverified" });
+                if (_mode == PracticeMode.WorthyOpponent
+                    && damage.Identity == DynelManager.LocalPlayer.Identity
+                    && damage.Target == _opponent && damage.Amount > 0)
+                {
+                    if (Time.AONormalTime - _worthyDamageWindowStart >= 10)
+                    {
+                        _worthyDamageWindowStart = Time.AONormalTime;
+                        _worthyDamageWindowAmount = 0;
+                    }
+                    _worthyDamageWindowAmount += damage.Amount;
+                    var opponent = DynelManager.Players.FirstOrDefault(p => p.Identity == _opponent);
+                    var cap = Math.Max(100, (opponent?.MaxHealth ?? 1000) * 0.15);
+                    if (_worthyDamageWindowAmount > cap)
+                        _worthyDamagePauseUntil = Math.Max(_worthyDamagePauseUntil, Time.AONormalTime + 3);
+                }
+            }
+            else if (message is CharacterActionMessage action
+                && ((action.Identity == _opponent && action.Target == DynelManager.LocalPlayer.Identity)
+                    || (action.Target == _opponent && action.Identity == DynelManager.LocalPlayer.Identity)))
+                _recorder.Record("characterActionPacket", new { actor = action.Identity.Instance,
+                    target = action.Target.Instance, action = action.Action.ToString(),
+                    action.Parameter1, action.Parameter2, action.Unknown1, action.Unknown2 });
+        }
+
+        private void RecordItemUsed(object sender, ItemUsedEventArgs e)
+        {
+            if (!OwnsPracticeService || !_sessionAccepted || _recorder == null) return;
+            if (e.OwnerIdentity == DynelManager.LocalPlayer.Identity)
+                _recorder.Record("itemUsed", new { item = e.Item?.Name, owner = e.OwnerIdentity.Instance });
+        }
+
+    }
+}
