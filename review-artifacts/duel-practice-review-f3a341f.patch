+        private static Item FindMatchingItem(IEnumerable<Item> items, string itemName)
+        {
+            Item exactMatch = items.FirstOrDefault(candidate =>
+                !string.IsNullOrWhiteSpace(candidate.Name) &&
+                string.Equals(candidate.Name, itemName, StringComparison.OrdinalIgnoreCase));
+
+            if (exactMatch != null)
+            {
+                return exactMatch;
+            }
+
+            return items.FirstOrDefault(candidate =>
+                !string.IsNullOrWhiteSpace(candidate.Name) &&
+                candidate.Name.IndexOf(itemName, StringComparison.OrdinalIgnoreCase) >= 0);
+        }
+
+        private static Item FindMatchingItem(IEnumerable<Item> items, PendingEquipAction action)
+        {
+            if (items == null || action == null)
+            {
+                return null;
+            }
+
+            string identityKey = action.ItemIdentityKey;
+            if (!string.IsNullOrWhiteSpace(identityKey))
+            {
+                Item identityMatch = items.FirstOrDefault(candidate => GetItemIdentityKey(candidate) == identityKey);
+                if (identityMatch != null)
+                {
+                    return identityMatch;
+                }
+            }
+
+            return FindMatchingItem(items, action.ItemName);
+        }
