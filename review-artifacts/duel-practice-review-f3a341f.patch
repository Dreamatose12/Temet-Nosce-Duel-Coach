new file mode 100644
index 0000000..ca7d08d
--- /dev/null
+++ b/Profession Handlers/ProfessionHandler.Agent.DuelPractice/AdaptiveEquipment.cs	
@@ -0,0 +1,109 @@
+using System;
+using System.IO;
+using AOSharp.Core;
+using AOSharp.Core.UI;
+using Newtonsoft.Json;
+
+namespace ProfessionHandler.Agent.DuelPractice
+{
+    internal sealed class AdaptiveEquipmentSettings
+    {
+        public bool Enabled { get; set; }
+        public string AttackPreset { get; set; } = "maxar";
+        public string NanoDefensePreset { get; set; } = "maxnr";
+        public string LowHealthPreset { get; set; } = "defense";
+        public string ReturnPreset { get; set; } = "baseline";
+        public int LowHealthPercent { get; set; } = 35;
+        public double MinimumSwapIntervalSeconds { get; set; } = 10;
+    }
+
+    public partial class AgentDuelPracticeHandler
+    {
+        private Equipment.DuelEquipmentEngine _equipment;
+        private AdaptiveEquipmentSettings _gearSettings = new AdaptiveEquipmentSettings();
+        private bool _adaptiveGearReady;
+        private bool _gearRestorePending;
+        private bool _gearTouched;
+        private string _gearRequested;
+        private double _nextGearAt;
+
+        private void InitializeEquipment(string pluginDir)
+        {
+            _equipment = new Equipment.DuelEquipmentEngine();
+            _equipment.Initialize(pluginDir);
+            var path = Path.Combine(pluginDir, "DuelAdaptiveEquipment.json");
+            try
+            {
+                if (File.Exists(path)) _gearSettings = JsonConvert.DeserializeObject<AdaptiveEquipmentSettings>(File.ReadAllText(path)) ?? new AdaptiveEquipmentSettings();
+                else File.WriteAllText(path, JsonConvert.SerializeObject(_gearSettings, Formatting.Indented));
+            }
+            catch (Exception e) { Chat.WriteLine("Adaptive equipment configuration unavailable: " + e.Message); }
+        }
+
+        private void BeginAdaptiveEquipment()
+        {
+            _adaptiveGearReady = false;
+            if (_mode != PracticeMode.AiOverlord || !_gearSettings.Enabled) return;
+            _adaptiveGearReady = _equipment.CanRestore(_gearSettings.ReturnPreset,
+                new[] { _gearSettings.AttackPreset, _gearSettings.NanoDefensePreset, _gearSettings.LowHealthPreset }, out var reason);
+            _recorder?.Record("equipmentReadiness", new { ready = _adaptiveGearReady, reason });
+            if (!_adaptiveGearReady) Chat.WriteLine("Adaptive gear unavailable: " + reason);
+        }
+
+        private void TickEquipment()
+        {
+            if (_equipment == null) return;
+            _equipment.Tick();
+            if (_gearRequested != null && !_equipment.Busy)
+            {
+                bool equipped = _equipment.IsEquipped(_gearRequested);
+                _recorder?.Record("equipmentResult", new { preset = _gearRequested, observedEquipped = equipped });
+                Chat.WriteLine("Adaptive equipment: " + _gearRequested + (equipped ? " observed equipped" : " NOT fully equipped"));
+                _gearRequested = null;
+                if (!equipped) _adaptiveGearReady = false;
+            }
+            if (_gearRestorePending && !_equipment.Busy && !Game.IsZoning && DynelManager.LocalPlayer.IsAlive)
+            {
+                if (_equipment.IsEquipped(_gearSettings.ReturnPreset)) { _gearRestorePending = false; _gearTouched = false; return; }
+                if (Time.AONormalTime < _nextGearAt) return;
+                RequestEquipment(_gearSettings.ReturnPreset, "Return to pre-practice preset");
+            }
+        }
+
+        private void UpdateAdaptiveEquipment(SimpleChar target)
+        {
+            if (!_adaptiveGearReady || _mode != PracticeMode.AiOverlord || !_sessionAccepted
+                || Time.AONormalTime < _attackReadyAt || _equipment.Busy || Time.AONormalTime < _nextGearAt) return;
+            string profession = target.Profession.ToString();
+            bool caster = profession == "Doctor" || profession == "NanoTechnician" || profession == "Trader" || profession == "MetaPhysicist";
+            string preset;
+            string reason;
+            if (DynelManager.LocalPlayer.HealthPercent <= Math.Max(1, Math.Min(90, _gearSettings.LowHealthPercent)))
+            { preset = _gearSettings.LowHealthPreset; reason = "Low local health"; }
+            else if (HasObservedEvasionDefense(target))
+            { preset = _gearSettings.AttackPreset; reason = "Observed evasion defense; prioritize configured attack-rating gear"; }
+            else if (caster)
+            { preset = _gearSettings.NanoDefensePreset; reason = "Profession-based nano-threat heuristic, not measured opponent nanoskills"; }
+            else { preset = _gearSettings.AttackPreset; reason = "Default offensive preset"; }
+            if (!_equipment.IsEquipped(preset)) RequestEquipment(preset, reason);
+        }
+
+        private void RequestEquipment(string preset, string reason)
+        {
+            _nextGearAt = Time.AONormalTime + Math.Max(5, _gearSettings.MinimumSwapIntervalSeconds);
+            bool accepted = _equipment.TryQueue(preset, out var error);
+            _recorder?.Record("equipmentRequested", new { preset, reason, accepted, error });
+            if (accepted) { _gearRequested = preset; _gearTouched = true; }
+            else { Chat.WriteLine("Adaptive equipment: " + error); _adaptiveGearReady = false; }
+        }
+
+        private void EndAdaptiveEquipment()
+        {
+            if (_gearTouched) _gearRestorePending = true;
+            _adaptiveGearReady = false;
+            // Cancel deferred actions at the duel boundary; restore on subsequent safe updates.
+            _equipment?.Cancel();
+            _gearRequested = null;
+        }
+    }
+}
diff --git a/Profession Handlers/ProfessionHandler.Agent.DuelPractice/AgentDuelPracticeHandler.cs b/Profession Handlers/ProfessionHandler.Agent.DuelPractice/AgentDuelPracticeHandler.cs
