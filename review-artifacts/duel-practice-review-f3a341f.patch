+        private static bool TryUseMobileBankItem(out string itemName)
+        {
+            itemName = null;
+
+            Item preferredItem = Inventory.Items.FirstOrDefault(candidate =>
+                candidate != null &&
+                !candidate.IsEquipped &&
+                !string.IsNullOrWhiteSpace(candidate.Name) &&
+                candidate.Name.IndexOf("mobile", StringComparison.OrdinalIgnoreCase) >= 0 &&
+                candidate.Name.IndexOf("bank", StringComparison.OrdinalIgnoreCase) >= 0);
+
+            Item fallbackItem = preferredItem ?? Inventory.Items.FirstOrDefault(candidate =>
+                candidate != null &&
+                !candidate.IsEquipped &&
+                !string.IsNullOrWhiteSpace(candidate.Name) &&
+                candidate.Name.IndexOf("bank", StringComparison.OrdinalIgnoreCase) >= 0 &&
+                candidate.Name.IndexOf("credit", StringComparison.OrdinalIgnoreCase) < 0);
+
+            Item bankAccessItem = fallbackItem;
+            if (bankAccessItem == null)
+            {
+                return false;
+            }
+
+            try
+            {
+                bankAccessItem.Use();
+                itemName = bankAccessItem.Name;
+                return true;
+            }
+            catch
+            {
+                return false;
+            }
+        }
