+            }
+
+            backpack = Inventory.Backpacks.FirstOrDefault(candidate =>
+                !string.IsNullOrWhiteSpace(candidate.Name) &&
+                string.Equals(candidate.Name, bagReference.Name, StringComparison.OrdinalIgnoreCase));
+
