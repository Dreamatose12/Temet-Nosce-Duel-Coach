+        private void OnUpdate(object sender, float deltaTime)
+        {
+            try
+            {
+                if (_pendingPresetPreparationState != null)
+                {
+                    bool prepTimedOut = DateTime.UtcNow - _pendingPresetPreparationState.StartedAtUtc >= PresetPreparationTimeout;
+
+                    if (prepTimedOut || !Inventory.Backpacks.Any(candidate => !candidate.IsOpen))
+                    {
+                        FinalizePresetPreparation();
+                    }
+                    else
+                    {
+                        return;
+                    }
+                }
+
+                if (_pendingBagOpenState != null)
+                {
+                    bool bagWaitExpired = DateTime.UtcNow - _pendingBagOpenState.StartedAtUtc >= BagOpenTimeout;
+
+                    if (!bagWaitExpired &&
+                        !TryFindAccessibleItem(_pendingBagOpenState.Action, out _, out _, out _))
+                    {
+                        return;
+                    }
+
+                    PendingEquipAction deferredAction = _pendingBagOpenState.Action;
+                    _pendingBagOpenState = null;
+                    ProcessEquipAction(deferredAction);
+                    return;
+                }
+
+                if (_pendingInventoryMoveState != null)
+                {
+                    if (TryFindInventoryOnlyItem(_pendingInventoryMoveState.Action, out _))
+                    {
+                        PendingEquipAction deferredAction = _pendingInventoryMoveState.Action;
+                        _pendingInventoryMoveState = null;
+                        ProcessEquipAction(deferredAction);
+                        return;
+                    }
+
+                    if (DateTime.UtcNow - _pendingInventoryMoveState.StartedAtUtc >= InventoryMoveTimeout)
+                    {
+                        Chat.WriteLine($"Timed out waiting for '{_pendingInventoryMoveState.Action.ItemName}' to reach inventory.");
+                        _pendingInventoryMoveState = null;
+                    }
+                    else
+                    {
+                        return;
+                    }
+                }
+
+                if (_pendingBankAccessState != null)
+                {
+                    bool bankAccessReady = HasVisibleBankAccess();
+                    bool bankWaitExpired = DateTime.UtcNow - _pendingBankAccessState.StartedAtUtc >= BankAccessRetryTimeout;
+
+                    if (!bankAccessReady && !bankWaitExpired)
+                    {
+                        return;
+                    }
+
+                    string deferredItemName = _pendingBankAccessState.ItemName;
+                    _pendingBankAccessState = null;
+                    HandleFindCommand(new[] { "find", deferredItemName });
+                    return;
+                }
+
+                if (_pendingSlotClearState != null)
+                {
+                    if (!TryFindEquippedItemInSlot(_pendingSlotClearState.TargetSlot, out _))
+                    {
+                        PendingEquipAction deferredAction = _pendingSlotClearState.Action;
+                        Chat.WriteLine($"Cleared '{_pendingSlotClearState.TargetSlot}'.");
+                        _pendingSlotClearState = null;
+                        ProcessEquipAction(deferredAction);
+                        return;
+                    }
+
+                    if (DateTime.UtcNow - _pendingSlotClearState.StartedAtUtc >= SlotClearTimeout)
+                    {
+                        Chat.WriteLine($"Timed out waiting for '{_pendingSlotClearState.TargetSlot}' to clear.");
+                        _pendingSlotClearState = null;
+                    }
+                    else
+                    {
+                        return;
+                    }
+                }
+
+                if (_pendingEquipState != null)
+                {
+                    if (TryResolvePendingEquip(out string completionMessage))
+                    {
+                        if (!string.IsNullOrWhiteSpace(completionMessage))
+                        {
+                            Chat.WriteLine(completionMessage);
+                        }
+
+                        RecordSwapResult(new SwapResultEntry
+                        {
+                            AtUtc = DateTime.UtcNow,
+                            PresetName = _pendingEquipState.Action.PresetName,
+                            Status = "success",
+                            Message = completionMessage ?? $"Equipped '{_pendingEquipState.ItemName}'."
+                        });
+
+                        _pendingEquipState = null;
+                    }
+                    else if (DateTime.UtcNow - _pendingEquipState.StartedAtUtc >= EquipOperationTimeout)
+                    {
+                        if (TryStartInventoryFallback(_pendingEquipState.Action, out string fallbackMessage))
+                        {
+                            Chat.WriteLine(fallbackMessage);
+                            _pendingEquipState = null;
+                            return;
+                        }
+
+                        if (_pendingEquipState.Action.AttemptCount + 1 < MaxEquipAttempts)
+                        {
+                            PendingEquipAction retryAction = _pendingEquipState.Action.WithAttemptCount(_pendingEquipState.Action.AttemptCount + 1);
+                            _equipQueue.Enqueue(retryAction);
+                            Chat.WriteLine($"Timed out waiting for '{_pendingEquipState.ItemName}' to equip to '{_pendingEquipState.TargetSlot}'. Retrying.");
+                        }
+                        else
+                        {
+                            Chat.WriteLine($"Timed out waiting for '{_pendingEquipState.ItemName}' to equip to '{_pendingEquipState.TargetSlot}'.");
+                            RecordSwapResult(new SwapResultEntry
+                            {
+                                AtUtc = DateTime.UtcNow,
+                                PresetName = _pendingEquipState.Action.PresetName,
+                                Status = "blocked",
+                                Message = $"Timed out waiting for '{_pendingEquipState.ItemName}' to equip to '{_pendingEquipState.TargetSlot}'."
+                            });
+                        }
+
+                        _pendingEquipState = null;
+                    }
+                    else
+                    {
+                        return;
+                    }
+                }
+
+                if (_equipQueue.Count == 0)
+                {
+                    return;
+                }
+
+                PendingEquipAction action = _equipQueue.Dequeue();
+                ProcessEquipAction(action);
+            }
+            catch (Exception ex)
+            {
+                ResetSwapPipeline();
+                Chat.WriteLine($"EquipManager update error: {ex.GetType().Name}: {ex.Message}");
+            }
+        }
+
+        private void ProcessEquipAction(PendingEquipAction action)
+        {
+            try
+            {
+                if (!TryFindAccessibleItem(action, out Item item, out string sourceDescription, out BagReference sourceBagReference))
+                {
+                    if (!action.InventoryOnly &&
+                        TryOpenClosedInventoryBags(out int openedBagCount))
+                    {
+                        _pendingBagOpenState = new PendingBagOpenState(
+                            action.WithAttemptCount(action.AttemptCount + 1),
+                            DateTime.UtcNow);
+
+                        Chat.WriteLine($"Opening {openedBagCount} inventory bag(s) to look for '{action.ItemName}'.");
+                        return;
+                    }
+
+                    Chat.WriteLine($"Could not find '{action.ItemName}' in inventory or open inventory bags.");
+                    RecordSwapResult(new SwapResultEntry
+                    {
+                        AtUtc = DateTime.UtcNow,
+                        PresetName = action.PresetName,
+                        Status = "missing",
+                        Message = $"Could not find '{action.ItemName}'."
+                    });
+                    return;
+                }
+
+                action = action.WithResolvedSource(GetItemIdentityKey(item), sourceBagReference);
+
+                if (action.TargetSlot.HasValue &&
+                    TryFindEquippedItemInSlot(action.TargetSlot.Value, out Item equippedItem) &&
+                    IsMatchingItemName(equippedItem?.Name, action.ItemName))
+                {
+                    Chat.WriteLine($"'{equippedItem.Name}' is already equipped in '{action.TargetSlot.Value}'.");
+                    RecordSwapResult(new SwapResultEntry
+                    {
+                        AtUtc = DateTime.UtcNow,
+                        PresetName = action.PresetName,
+                        Status = "skipped",
+                        Message = $"'{equippedItem.Name}' already equipped in '{action.TargetSlot.Value}'."
+                    });
+                    return;
+                }
+
+                if (!TryResolveTargetSlot(item, action.TargetSlot, out EquipSlot slot, out string errorMessage))
+                {
+                    Chat.WriteLine($"Could not equip '{action.ItemName}': {errorMessage}");
+                    RecordSwapResult(new SwapResultEntry
+                    {
+                        AtUtc = DateTime.UtcNow,
+                        PresetName = action.PresetName,
+                        Status = "blocked",
+                        Message = $"Could not resolve slot for '{action.ItemName}': {errorMessage}"
+                    });
+                    return;
+                }
+
+                if (IsSlotLocked(slot))
+                {
+                    Chat.WriteLine($"Skipped '{action.ItemName}' because slot '{slot}' is locked.");
+                    RecordSwapResult(new SwapResultEntry
+                    {
+                        AtUtc = DateTime.UtcNow,
+                        PresetName = action.PresetName,
+                        Status = "skipped",
+                        Message = $"Locked slot '{slot}' prevented '{action.ItemName}'."
+                    });
+                    return;
+                }
+
+                RememberItemHomeBag(item, sourceBagReference);
+
+                if (TryFindEquippedItemInSlot(slot, out Item currentlyEquippedItem) &&
+                    !IsMatchingItemName(currentlyEquippedItem?.Name, action.ItemName))
+                {
+                    try
+                    {
+                        if (!TryStoreClearedItem(currentlyEquippedItem, out string destinationDescription, out string storageError))
+                        {
+                            Chat.WriteLine($"Could not clear '{slot}': {storageError}");
+                            RecordSwapResult(new SwapResultEntry
+                            {
+                                AtUtc = DateTime.UtcNow,
+                                PresetName = action.PresetName,
+                                Status = "blocked",
+                                Message = $"Could not clear '{slot}': {storageError}"
+                            });
+                            return;
+                        }
+
+                        _pendingSlotClearState = new PendingSlotClearState(
+                            action.WithAttemptCount(action.AttemptCount + 1),
+                            slot,
+                            DateTime.UtcNow);
+
+                        Chat.WriteLine($"Clearing '{slot}' by moving '{currentlyEquippedItem.Name}' to {destinationDescription}.");
+                        return;
+                    }
+                    catch (Exception ex)
+                    {
+                        Chat.WriteLine($"Could not clear '{slot}': {ex.Message}");
+                        RecordSwapResult(new SwapResultEntry
+                        {
+                            AtUtc = DateTime.UtcNow,
+                            PresetName = action.PresetName,
+                            Status = "blocked",
+                            Message = $"Could not clear '{slot}': {ex.Message}"
+                        });
+                        return;
+                    }
+                }
+
+                if (!TryEquipItemToSlot(item, slot, out errorMessage))
+                {
+                    if (TryStartInventoryFallback(action, out string fallbackMessage))
+                    {
+                        Chat.WriteLine(fallbackMessage);
+                        return;
+                    }
+
+                    Chat.WriteLine($"Could not equip '{action.ItemName}': {errorMessage}");
+                    RecordSwapResult(new SwapResultEntry
+                    {
+                        AtUtc = DateTime.UtcNow,
+                        PresetName = action.PresetName,
+                        Status = "blocked",
+                        Message = $"Could not equip '{action.ItemName}': {errorMessage}"
+                    });
+                    return;
+                }
+
+                _pendingEquipState = new PendingEquipState(action, item.Name ?? action.ItemName, slot, DateTime.UtcNow);
+                string sourceSuffix = string.IsNullOrWhiteSpace(sourceDescription) ? string.Empty : $" from {sourceDescription}";
+                Chat.WriteLine($"Starting equip of '{item.Name}' to '{slot}'{sourceSuffix}.");
+            }
+            catch (Exception ex)
+            {
+                Chat.WriteLine($"EquipManager error for '{action.ItemName}': {ex.GetType().Name}: {ex.Message}");
+                RecordSwapResult(new SwapResultEntry
+                {
+                    AtUtc = DateTime.UtcNow,
+                    PresetName = action.PresetName,
+                    Status = "blocked",
+                    Message = $"{ex.GetType().Name}: {ex.Message}"
+                });
+            }
+        }
