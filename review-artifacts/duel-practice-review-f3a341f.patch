+        private void RecordSwapResult(SwapResultEntry entry)
+        {
+            if (entry == null)
+            {
+                return;
+            }
+
+            _config.RecentResults.Insert(0, entry);
+            if (_config.RecentResults.Count > 20)
+            {
+                _config.RecentResults.RemoveRange(20, _config.RecentResults.Count - 20);
+            }
+
+            SaveConfig();
+            RefreshSummary();
