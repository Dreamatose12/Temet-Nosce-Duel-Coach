+        private string PreparationReason()
+        {
+            try
+            {
+                if (!IsPracticePreparationActive)
+                    return null;
+
+                if (Spell.HasPendingCast)
+                    return "nano casting";
+
+                if (!IsConfiguredFalseProfessionReady(out var falseProfessionReason))
+                    return falseProfessionReason;
+
+                return null;
+            }
